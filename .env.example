# 复制本文件为 .env 并填入你的密钥
# 阿里云百炼（DashScope）API Key，获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxx

# ---------------- 以下仅供公网演示，本地开发不用填 ----------------
# 设了 DEMO_PASSWORD 才会启用访问门禁（Basic Auth + 每日配额 + 频率限制）；
# 留空则门禁整体不生效，本地 `uvicorn app:app` 行为和以前完全一样。
# DEMO_PASSWORD=换成你自己的密码
# DEMO_USER=demo
# DEMO_DAILY_LIMIT=200
# DEMO_RATE_PER_MIN=20
